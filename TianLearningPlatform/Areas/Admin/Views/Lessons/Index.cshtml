@model List<Tian_fullstack.Areas.Learning.Models.Lesson>
@{
    ViewData["Title"] = "Create a lesson";
    Layout = "_LayoutRegistered";
}
@section Style {
    <link rel="stylesheet" href="~/css/ModelIndex.css"/>
}

<h1>Lessons list:</h1>
<div id="tableWrapper">
<table>
    <thead>
        <tr>
            <th>
                Order
            </th>

            <th>
                Title
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
    @foreach (var lesson in Model)
        {
        <tr>
            <td>
                @lesson.Order
            </td>
            <td>
                @lesson.Title
            </td>
            <td >
                <div class ="actions">
                    <a asp-action="Edit" asp-route-lessonId="@lesson.Id" class="editBtn">Edit</a>
                    <a asp-action="Delete" asp-route-lessonId="@lesson.Id" class="editBtn">Delete</a>
                    <a asp-action="Details" asp-route-lessonId="@lesson.Id" class="editBtn">Details</a>
                </div>
            </td>
        </tr>
        }
    </tbody>
</table>

</div>
<a asp-controller="Lessons" asp-action="Create">Crate a new lesson</a>
<a asp-area="Admin" asp-controller="Home" asp-action="Index"> &lt;&lt; Back to admin panel</a>
