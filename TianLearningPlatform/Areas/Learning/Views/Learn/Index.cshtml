@using Tian_fullstack.Areas.Learning.Models
@{
    ViewData["Title"] = "Learn";
    Layout = "_LayoutRegistered";
}
@section Style {
    <link rel="stylesheet" href="~/css/Learn.css" />
}
<div id="prgoress">
    Overall<br />
    course<br />
    progress<br />
    is @(ViewBag.progressInPercentage)%
</div>
<div id="lessons">
    @*
    Deciding how each lesson should appear (passed, unlocked, locked or in development)
    *@
    @{
        // Finding the order of the last lesson in the DB
        var lastLessonInDb = (ViewBag.lessons as List<Lesson>).LastOrDefault() != null ? (ViewBag.lessons as List<Lesson>).LastOrDefault().Order : 0;
    }
    @for (var i = 1; i <= lastLessonInDb; i++)
    {
        var lessonI = (ViewBag.lessons as List<Lesson>).FirstOrDefault(l => l.Order == i);
        if (lessonI == null)
        {
            <p class="inDev" title="The lesson is in development">
                <img src="../images/inDevelopment.svg">
            </p>
            <div class="line">
            </div>
        }
        else
        {
            @* 
            Each lesson which number is equal or less than the last passed lesson 
            will be displayed as passed
            *@
            @if (lessonI.Order <= ViewBag.lastLessonNumber)
            {
                <a class="lesson" id="first_lesson" title="@lessonI.Title" asp-area="Learning" asp-controller="Lesson" asp-action="Lesson" asp-route-lessonOrder="@lessonI.Order" asp-route-slideOrder="1">
                    <img src="../images/play_button.svg">
                </a>
                <div class="line">
                </div>
            }
            @*
            The lesson which is directly after the last passed lesson and
            the first lesson will be unlocked.
            NOTE: the first lesson is unlocked ALWAYS because without it
            new users won't be able to start learning.
            *@
            else if (lessonI.Order == ViewBag.lastLessonNumber + 1 || lessonI.Order == 1)
            {
                <a class="lesson" id="first_lesson" title="@lessonI.Title" asp-area="Learning" asp-controller="Lesson" asp-action="Lesson" asp-route-lessonOrder="@lessonI.Order" asp-route-slideOrder="1">
                    <img src="../images/open.svg">
                </a>
                <div class="line">
                </div>
            }
            else
            {
                <a class="lesson closed" id="first_lesson" title="@lessonI.Title" asp-area="Learning" asp-controller="Lesson" asp-action="Lesson" asp-route-lessonOrder="@lessonI.Order" asp-route-slideOrder="1">
                    <img src="../images/lock.svg">
                </a>
                <div class="line">
                </div>
            }
        }
    }
</div>
<script>
    let lessons = document.getElementsByClassName("lesson");
    let colors = [
        `background: #1cc94a;
            border-color: #0c7a2a;
            color: #0c7a2a;`,
        `background: #1486e3;
            border-color: #0c4d82;
            color:  #0c4d82;`,
        `background: #e81010;
            border-color: #780b0b;
            color: #780b0b;`,
        `background: #f200ff;
            border-color: #77097d;
            color: #77097d;`
    ]
    let counter = 0;
    for (let i = 0; i < document.getElementsByClassName("lesson").length; i++) {
        if (counter == colors.length) {
            counter = 0;
        }
        lessons[i].style.cssText += colors[counter];
        counter++;
    }
</script>