@{
    ViewData["Title"] = "Profile";
    Layout = "_LayoutRegistered";
}
@section Style {
    <link rel="stylesheet" href="~/css/ChangePassword.css" />
}
<h1>Password Change</h1>
<div id="container">
    <p>Confirm your identity by typing your current password.</p>
    <form asp-action="ChangePassword" method="post">
        <label for="currentPassword">Current password: </label>
        <input id="currentPassword" name="currentPassword" type="password" />

        <label for="newPassword">New Password: </label>
        <input id="newPassword" name="newPassword" type="password"/>
        <p id="hints">
            @if (ViewBag.noMatch == true){
                <p style="color:red;">* The current password doesn't match with the password in our system</p>
            }
        </p>
        <button type="submit" id="submit"> Change password</button>
    </form>
</div>
@section Scripts{
    <script src="~/js/changePasswordValidation.js"></script>
}