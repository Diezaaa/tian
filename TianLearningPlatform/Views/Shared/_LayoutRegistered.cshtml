<!DOCTYPE html>
<html lang="en-US">
<head>
    <link rel="stylesheet" href="~/css/Reset.css">
    @RenderSection("Style", required: true)
    <link rel="stylesheet" href="~/css/LayoutRegistered.css">

    <title></title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Plus Jakarta Sans-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <img src="~/images/Logo.svg" id="logo">
        @RenderSection("HeaderZone", required: false)
    </header>
    @RenderSection("BodyZone", required: false)
    <main>
        @RenderBody()
    </main>
    <nav>
        <ul>
            <li>
                <a asp-area="Learning" asp-controller="Learn" asp-action="Index">
                    <div>
                        <img src="~/images/learn.svg">
                        <p>Learn</p>
                    </div>
                </a>
            </li>
            <li>
                <a asp-area="User" asp-controller="Profile" asp-action="Index">
                    <div>
                        <img src="~/images/profile.svg">
                        <p>Profile</p>
                    </div>
                </a>
            </li>
            @if (User.IsInRole("Admin"))
            {
                <li>
                <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                    <div>
                        <img src="~/images/admin_panel_icon.png">
                        <p>Admin panel</p>
                    </div>
                    </a>
                </li>
            }
        </ul>
    </nav>
    <footer>
        <div><span>Support email: </span>kotvesopogah@gmail.com</div>
    </footer>
    @RenderSection("Scripts", required: false)

</body>
</html>
