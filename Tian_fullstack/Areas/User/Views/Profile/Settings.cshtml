@{
    ViewData["Title"] = "Settings";
    Layout = "_LayoutRegistered";
}
@section Style {
    <link rel="stylesheet" href="~/css/Settings.css" />
}
@section HeaderZone {
    <a asp-area="User" asp-controller="Profile" asp-action="Index" id="back">
        <
    </a>
}
<div id="inner">
<div id="avatar">
        <img src="~/images/avatar_default.svg" id="photo">
    <img src="~/images/edit_button.png" id="edit_button">
</div>
<div id="inputs">
    <label for="nickname">Your name: </label>
    <input type="text" id="nickname">
    <label for="email">Email: </label>
    <input type="email" id="email">
</div>
<a class="setting">Change password</a>
<form asp-controller="Profile" asp-action="LogOut" id="logOutButton">
    <button type="submit" class="setting">Log out</button>
</form>
<form asp-controller="Profile" asp-action="DeleteAcc">
        <button id="delete_acc" type="submit" class="setting">Delete account</button>
</form>
</div>