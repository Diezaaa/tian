@using Tian_fullstack.Areas.Account.Models
@model User
@{
    ViewData["Title"] = "Profile";
    Layout = "_LayoutRegistered";
}
@section Style {
    <link rel="stylesheet" href="~/css/Profile.css" />
}
@section HeaderZone {
    <a asp-area="User" asp-controller="Profile" asp-action="Settings">
        <img src="~/images/settings.svg" id="settings" />
    </a>
}
<div id="inner">
    <div id="avatar">
        <img src="../images/avatar_default.svg">
        <p id="nickname">@ViewBag.user.UserName</p>
    </div>
    <div id="stats">
        <div id="day_streak">
            <img src="../images/fire_icon.svg">
            @ViewBag.streak days streak
        </div>
        <div id="percents">
            @ViewBag.percents% is completed
        </div>
    </div>
    <!-- The achievements system isn't good, make it with mdoels-->
    <div class="badges_title">
        Achievements you have:
    </div>
    <div class="badges">
        @if (ViewBag.percents >= 50)
        {
            <div class="badge">
                <img src="../images/half_way_badge.png">
                <span>Halfway there</span>
                Complete 50% of the course
            </div>
        }
        @if (ViewBag.percents == 100)
        {
            <div class="badge">
                <img src="../images/final_emoji.png">
                <span>Finalist</span>
                Complete the entire course
            </div>
        }
        @if (ViewBag.iSFirstLesson)
        {
            <div class="badge">
                <img src="../images/first_steps_badge.png">
                <span>First Steps</span>
                Complete the first lesson
            </div>
        }
        else if (!ViewBag.iSFirstLesson && !(ViewBag.percents == 100) && !(ViewBag.percents >= 50))
        {
            <p id="no_badges">You have no achievements!</p>
        }
    </div>
    <div class="badges_title">
        Achievements you don't have:
    </div>
    <div class="badges">
        @if (ViewBag.percents < 50)
        {
            <div class="badge">
                <img src="../images/half_way_badge.png">
                <span>Halfway there</span>
                Complete 50% of the course
            </div>
        }
        @if (ViewBag.percents != 100)
        {
            <div class="badge">
                <img src="../images/final_emoji.png">
                <span>Finalist</span>
                Complete the entire course
            </div>
        }
        @if (!ViewBag.iSFirstLesson)
        {
            <div class="badge">
                <img src="../images/first_steps_badge.png">
                <span>First Steps</span>
                Complete the first lesson
            </div>
        }
        else if (ViewBag.iSFirstLesson && ViewBag.percents == 100 && ViewBag.percents >= 50)
        {
            <p id="no_badges">You have gotten all the achievements!</p>
        }
    </div>
</div>