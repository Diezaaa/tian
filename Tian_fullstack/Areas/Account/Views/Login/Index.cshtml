@{
    ViewData["Title"] = "Sign in";
    Layout = "_LayoutUnregistered";
}
@section Style {
        <link rel="stylesheet" href="~/css/RegisterationAndSingIn.css" />
}
<h1>Sign in</h1>
<form method="post">
    <label for="username" >Username: </label>
    <input name="username" id="username" />
    <label for="password">Password: </label>
    <input type="password" name ="password" id="password">
    <p id="hints"></p>
    <button type="submit" id="submit">Sign in</button>
</form>
<a asp-area="Account" asp-controller="Register" asp-action="Index">Don't have an account?</a>
<script src="~/js/signInValidation.js"></script>