@{
    ViewData["Title"] = "Learn";
    Layout = "_LayoutRegistered";
}
@section Style {
    <link rel="stylesheet" href="~/css/Learn.css" />
}
<div id="prgoress">
    Overall<br />
    course<br />
    progress<br />
    is @ViewBag.progress%
</div>
<div id="lessons">
    @*
        Deciding how each lesson should appear (passed, unlcoked or locked)
    *@
    @foreach (var lesson in ViewBag.lessons)
    {
        @* Each lesson which number is equal or less than the last passed lesson 
             will be displayed as passed
        *@
        if (lesson.Order <= ViewBag.lastLessonNumber)
        {
            <a class="lesson" id="first_lesson" title="@lesson.Title" asp-area="Learning" asp-controller="Lesson" asp-action="Lesson" asp-route-lessonOrder="@lesson.Order" asp-route-slideOrder="1">
                <img src="../images/play_button.svg">
            </a>
            <div class="line">
            </div>
        }
        <!-- The lesson which is directly after the last passed lesson and
             the first lesson will be unlocked.
             NOTE: the first lesson is unlocked ALWAYS because without it
             new users won't be able to start learning.
        -->
        @else if (lesson.Order == ViewBag.lastLessonNumber + 1 || lesson.Order == 1)
        {
            <a class="lesson" id="first_lesson" title="@lesson.Title" asp-area="Learning" asp-controller="Lesson" asp-action="Lesson" asp-route-lessonOrder="@lesson.Order" asp-route-slideOrder="1">
                <img src="../images/open.svg">
            </a>
            <div class="line">
            </div>
        }
        else
        {
            <a class="lesson closed" id="first_lesson" title="@lesson.Title" asp-area="Learning" asp-controller="Lesson" asp-action="Lesson" asp-route-lessonOrder="@lesson.Order" asp-route-slideOrder="1">
                <img src="../images/lock.svg">
            </a>
            <div class="line">
            </div>
        }

    }
</div>
<script>
    let lessons = document.getElementsByClassName("lesson");
    let colors = [
        `background: #1cc94a;
            border-color: #0c7a2a;
            color: #0c7a2a;`,
        `background: #1486e3;
            border-color: #0c4d82;
            color:  #0c4d82;`,
        `background: #e81010;
            border-color: #780b0b;
            color: #780b0b;`,
        `background: #f200ff;
            border-color: #77097d;
            color: #77097d;`
    ]
    let counter = 0;
    for (let i = 0; i < document.getElementsByClassName("lesson").length; i++) {
        if (counter == colors.length) {
            counter = 0;
        }
        lessons[i].style.cssText += colors[counter];
        counter++;
    }
</script>