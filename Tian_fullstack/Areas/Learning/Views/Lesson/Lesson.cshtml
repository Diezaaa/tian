@{
    ViewData["Title"] = "Lesson";
    Layout = "_LayoutRegistered";
}
@section Style {
    <link rel="stylesheet" href="~/css/Lesson.css" />
}
@section BodyZone{
    <div id="progress_bar">
        @{
        if (@ViewBag.slide.Order > 1)
            {
                <a asp-area="Learning" asp-controller="Lesson" asp-action="Lesson" asp-route-lessonOrder="@ViewBag.slide.LessonNumber" asp-route-slideOrder="@(@ViewBag.slide.Order - 1)" class="arrow">&larr;</a>
            }
        }
        @for (int i = 1; i <= ViewBag.numberOfSlides; i++)
        {
            if (ViewBag.slide.Order >= i)
            {
                <span class="completed_sublesson"></span>

            }
            else
            {
                <span class="sublesson"></span>
            }
        }
        @if (@ViewBag.slide.Order != @ViewBag.numberOfSlides) 
    {
            <a asp-area="Learning" asp-controller="Lesson" asp-action="Lesson" asp-route-lessonOrder="@ViewBag.slide.LessonNumber" asp-route-slideOrder="@(@ViewBag.slide.Order + 1)" class="arrow">&rarr;</a>
            }
    </div>
}

<div id="inner">
    @Html.Raw(ViewBag.slide.Content.Replace(Environment.NewLine, "<br />"))
    @if (ViewBag.slide.ImagePath is not null)
    {
        <img src="~/images/imagesForSlides/@ViewBag.slide.ImagePath" id="slidePhoto" />
    }
    @if (ViewBag.slide.enableCodeEditor)
    {
        <iframe src="https://trinket.io/embed/python/fab425b244b2" width="100%" height="356" frameborder="0" marginwidth="0" marginheight="0" allowfullscreen></iframe>
    }
    @if (ViewBag.isAQuiz)
    {
        <form method="post" asp-area="Learning" asp-controller="Lesson" asp-action="Lesson">
        @{
            int i = 0;
        }
            @foreach (var option in @ViewBag.slide.Options)
            {
                <label class="option">
                    <input type="radio" name="option" value="@(++i)">
                    @option
                </label>

            }

            <button type="submit">Check</button>        
            <p id="isCorrect">@TempData["isCorrect"]</p>
            <p id="isIncorrect">@TempData["isIncorrect"]</p>
        </form>

    }
</div>