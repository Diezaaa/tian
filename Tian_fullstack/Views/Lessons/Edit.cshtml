@model Lesson
@{
    ViewData["Title"] = "Edit a lesson";
    Layout = "_LayoutCrudOperations";
}
@section Style {
    <link rel="stylesheet" href="~/css/ModelCreate.css" />
}
@{
    int i = 0;
}

<h1>Edit a lesson</h1>
<form method="post" enctype="multipart/form-data">
    <label for="order">Order: </label>
    <input id="order" asp-for="Order" />

    <label for="title">Title: </label>
    <input id="title" asp-for="Title" />  <!-- Use Item1 to access Lesson -->
    <span asp-validation-for="Title" class="hints"></span>
    <span>Slides:</span>
    <button type="button" id="addSlideBtn">Add a slide</button>
    <div id="slides">
    @for (i = 0; i < Model.Slides.Count();i++)
    {
        <div>
            <hr />
            <span>Slide @(1+i):</span>
            <hr />
            <label for="content">Contnet: </label>
            <textarea id="content" asp-for="Slides[i].Content" for="content"></textarea>
            <div class="labelAndCheckBox">
                <input type="checkbox" asp-for="Slides[i].enableCodeEditor"/>
                <label for="enableCodeEditor">Enable code editor?</label>
            </div>
            @if (Model.Slides[i].ImagePath != null)
            {
                <div class="currentImage">
                    <label for="Slides">Upload Image</label>
                    <input type="file" name="imageFiles" class="uploadFiles" />
                    <span>Original image: </span>
                    <img src="~/images/imagesForSlides/@Model.Slides[i].ImagePath" />
                        <div class="labelAndCheckBox">
                        <input type="checkbox" name="deleteOriginal @i" />
                        <label for="enableCodeEditor">Delete original image?</label>
                    </div>
                </div>
            }
            else
            {
                <label for="Slides">Upload Image</label>
                <input type="file" name="imageFiles" class="uploadFiles" />
            }
                <span>Options:</span>
            <label for="option1">Option 1:</label>
            <input id="option1" asp-for="Slides[i].Options[0]" />
            <label for="option2">Option 2:</label>
            <input id="option2" asp-for="Slides[i].Options[1]" />
            <label for="option3">Option 3:</label>
            <input id="option3" asp-for="Slides[i].Options[2]" />
            <label for="option4">Option 4:</label>
            <input id="option4" asp-for="Slides[i].Options[3]" />
            <label for="correctAnswer">Correct Answer:</label>
            <input id="correctAnswer" asp-for="Slides[i].CorrectOptionIndex"/>
        </div>
    }
    </div>
    <button type="submit" id="sumbitBtn">Save</button>
</form>
<a asp-controller="Lessons" asp-action="Index">&lt;&lt; Back to the lessons</a>
<script>
    document.querySelectorAll('input[type="file"]').forEach(input => {
        const blankFile = new File([], " "); // Create a blank file with no extension
        const dataTransfer = new DataTransfer(); // Create a DataTransfer object
        dataTransfer.items.add(blankFile); // Add the blank file to the DataTransfer object
        input.files = dataTransfer.files; // Assign the files property of the file input
    });
</script>
<script>
    function addAblankFile() {
        let file = new File([], " ");
        let allInputs = document.querySelectorAll('input[type="file"]');
        let input = allInputs[allInputs.length - 1];
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        input.files = dataTransfer.files;
    }
    addAblankFile();
    let addSlideBtn = document.getElementById('addSlideBtn');
    let slidesDiv = document.getElementById('slides');
    let numberOfSlides = @i;
    addSlideBtn.addEventListener("click", function () {
        slidesDiv.insertAdjacentHTML('beforeend', `
            <div>
                    <hr>
                    <span>Slide ${numberOfSlides + 1}:</span>
                    <hr>
                    <label for="content">Contnet: </label>
                    <textarea id="content" for="content" data-val="true" data-val-required="The Content field is required." name="Slides[${numberOfSlides}].Content"></textarea>
                    <div class="enableEditor">
                    <input type="checkbox" data-val="true" data-val-required="The enableCodeEditor field is required." id="Slides_${numberOfSlides}__enableCodeEditor" name="Slides[${numberOfSlides}].enableCodeEditor" value="true">
                    <label for="enableCodeEditor">Enable code editor?</label>
                    </div>
                    <div>
                    <label for="Slides">Upload Image</label>
                    <input type="file" name="imageFiles">
                    </div>
                    <span>Options:</span>
                    <br>
                    <label for="option1">Option 1:</label>
                    <input id="option1" type="text" name="Slides[${numberOfSlides}].Options[0]" value="">
                    <label for="option2">Option 2:</label>
                    <input id="option2" type="text" name="Slides[${numberOfSlides}].Options[1]" value="">
                    <label for="option3">Option 3:</label>
                    <input id="option3" type="text" name="Slides[${numberOfSlides}].Options[2]" value="">
                    <label for="option4">Option 4:</label>
                    <input id="option4" type="text" name="Slides[${numberOfSlides}].Options[3]" value="">
                    <label for="correctAnswer">Correct Answer:</label>
                    <input id="correctAnswer" type="number" data-val="true" data-val-range="The field CorrectOptionIndex must be between 1 and 4." data-val-range-max="4" data-val-range-min="1" name="Slides[${numberOfSlides}].CorrectOptionIndex" value=""><input name="__Invariant" type="hidden" value="Slides[${numberOfSlides}].CorrectOptionIndex">
             </div>`);
        numberOfSlides++;
        addAblankFile();
    })

</script>