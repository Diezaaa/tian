@model Lesson
@{
    ViewData["Title"] = "Create a lesson";
    Layout = "_LayoutCrudOperations";
}

@section Style {
    <link rel="stylesheet" href="~/css/ModelCreate.css" />
}

<h1>Create a new lesson</h1>
<form method="post" enctype="multipart/form-data" id="lessonForm">
    <label for="Order">Order: </label>
    <input id="Order" asp-for="Order" />
    <span class="error" id="OrderError"></span>
    <label for="Title">Title: </label>
    <input id="Title" asp-for="Title" />
    <span class="error" id="TitleError"></span>
    <span>Slides:</span>
    <button type="button" id="addSlideBtn">Add a slide</button>
    <div id="slides">

    </div>
    <button type="submit" id="sumbitBtn">Create</button>
</form>

<a asp-controller="Lessons" asp-action="Index">&lt;&lt; Back to the lessons</a>
@section Scripts
{
    <script src="~/js/lessonValidation.js"></script>
    <script>
        function addAblankFile() {
            let file = new File([], " ");
            let allInputs = document.querySelectorAll('input[type="file"]');
            let input = allInputs[allInputs.length - 1];
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            input.files = dataTransfer.files;
        }
    let addSlideBtn = document.getElementById('addSlideBtn');
    let slidesDiv = document.getElementById('slides');
    addSlideBtn.addEventListener("click", function () {
        slidesDiv.insertAdjacentHTML('beforeend', `
        <div class="slide">
                <hr>
                <span>Slide : </span>
                <button class="delete" type="button">Delete</button>
                <hr>
                <label for="slideContent">Contnet: </label>
                <textarea id="slideContent" name="Slides[].Content"></textarea>
                <span id="slideContentError" class="error"></span>
                <div class="enableEditor">
                        <input type="checkbox" name="Slides[].enableCodeEditor" id="slideEditor" value="true">
                        <label for="slideEditor">Enable code editor?</label>
                </div>
                <div>
                <label for="slideFile">Upload Image</label>
                <input type="file" name="imageFiles" id="slideFile">
                </div>
                <span>Options:</span>
                <br>
                <label for="option1">Option 1:</label>
                <input id="slideOption1" type="text" name="Slides[].Options[0]" value="">
                <label for="slideOption2">Option 2:</label>
                <input id="slideOption2" type="text" name="Slides[].Options[1]" value="">
                <label for="slideOption3">Option 3:</label>
                <input id="slideOption3" type="text" name="Slides[].Options[2]" value="">
                <label for="slideOption4">Option 4:</label>
                <input id="slideOption4" type="text" name="Slides[].Options[3]" value="">
                <label for="slideCorrectAnswer">Correct Answer:</label>
                <input id="slideCorrectAnswer" type="number" name="Slides[].CorrectOptionIndex">
                <span id="slideOptionsMessage" class="error"></span>
         </div>`);
            addAblankFile();

    })

</script>
<script>
    addSlideBtn.addEventListener("click", () => {
        orderSlides()
        let deleteBtns = document.getElementsByClassName("delete")
        for (let i = 0; i < deleteBtns.length; i++) 
        {
            deleteBtns[i].addEventListener("click", () => { deleteSlide(event); orderSlides() })
        }
    })
    function deleteSlide(event) 
    { 
        event.target.parentNode.remove()
    }
    function changeSlideNum(string, slideNum, position) 
    { 
        if (!isNaN(parseInt(string[position])))
        {
                string = string.replace(/\d/, '');
        }
        let firstPart = string.slice(0, position)
        let secondPart = string.slice(position)
        return firstPart + slideNum + secondPart;
    }
        function orderSlides() {
            for (let i = 0; i < document.getElementsByClassName("slide").length; i++) {
                slideInputsLabels = document.getElementsByClassName("slide")[i].querySelectorAll("input:not([type='hidden']), textarea, label, .error")
                document.getElementsByClassName("slide")[i].querySelector("span:first-of-type").innerText = `Slide ${i + 1}`
                slideInputsLabels.forEach((elem) => {

                    if ((elem.tagName == "INPUT" && elem.type != "file") || elem.tagName == "TEXTAREA") {
                        elem.setAttribute("id", changeSlideNum(elem.getAttribute("id"), i, 5))
                        elem.setAttribute("name", changeSlideNum(elem.getAttribute("name"), i, 7))

                    }
                    else if (elem.tagName == "SPAN") {
                        elem.setAttribute("id", changeSlideNum(elem.getAttribute("id"), i, 5))
                    }
                    else if (elem.tagName == "LABEL") {
                        elem.setAttribute("for", changeSlideNum(elem.getAttribute("for"), i, 5))
                    }
                })
            }
        }
</script>
}