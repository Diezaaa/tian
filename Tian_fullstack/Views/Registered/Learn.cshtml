@model List<Lesson>
@{
    ViewData["Title"] = "Learn";
    Layout = "_LayoutRegistered";
}
@section Style {
    <link rel="stylesheet" href="~/css/Learn.css" />
}
<div id="prgoress">
    Overall<br />
    course<br />
    progress<br />
    is 0%
</div>
<div id="lessons">
@foreach (var lesson in Model)
{
    <a class="lesson" id="first_lesson" title="@lesson.Title" asp-controller="Registered" asp-action="Lesson" asp-route-lessonId="@lesson.Order" asp-route-slideOrder="1">
        <img src="../images/play_button.svg">
    </a>
    <div class="line">
    </div>
}
</div>
<script>
    let lessons = document.getElementsByClassName("lesson");
    let colors = [
        `background: #1cc94a;
        border-color: #0c7a2a;
        color: #0c7a2a;`,
        `background: #1486e3;
        border-color: #0c4d82;
        color:  #0c4d82;`,
        `background: #e81010;
        border-color: #780b0b;
        color: #780b0b;`,
        `background: #f200ff;
        border-color: #77097d;
        color: #77097d;`
    ]
    let counter = 0;
    for (let i = 0; i < document.getElementsByClassName("lesson").length; i++) 
    { 
        if (counter == colors.length) 
        {
            counter = 0;
        }
        lessons[i].style.cssText += colors[counter];
        counter++;
    }
</script>