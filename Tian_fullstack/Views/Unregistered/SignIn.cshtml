@{
    ViewData["Title"] = "Sign in";
    Layout = "_LayoutUnregistered";
}
@section Style {
        <link rel="stylesheet" href="~/css/RegisterationAndSingIn.css" />
}
<h1>Sign in</h1>
<form>
    <label for="email">Email: </label>
    <input type="email" id="email">
    <label for="password">Password: </label>
    <input type="password" id="password">
    <button type="submit">Sign in</button>
</form>
<a asp-controller="Unregistered" asp-action="Registeration">Don't have an account?</a>